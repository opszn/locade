{
  "name": "locade-local-prototype",
  "version": "0.3.0-alpha.2",
  "private": true,
  "type": "module",
  "description": "Local-first visual library for development projects",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build",
    "start": "node server/index.js",
    "dev": "npm run build && node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "npm run build && node --test tests/*.e2e.js",
    "test:discovery": "node tools/test-discovery.js",
    "benchmark:local": "node tools/benchmark-local.js",
    "check:source": "node tools/check-source.js",
    "build:mac": "node tools/build-macos.js",
    "test:mac": "node tools/test-macos.js",
    "test:install:mac": "node tools/test-install-macos.js",
    "package:mac": "node tools/package-macos.js",
    "format": "prettier --write src server tests tools/*.js vite.config.js index.html package.json",
    "format:check": "prettier --check src server tests tools/*.js vite.config.js index.html package.json",
    "check:mac": "node tools/check-macos.js",
    "diagnose:mac": "node tools/diagnose-macos.js"
  },
  "dependencies": {
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "vite": "^8.3.4"
  }
}
